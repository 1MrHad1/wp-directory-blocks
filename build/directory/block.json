{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "directory-blocks/directory",
  "title": "Directory",
  "category": "directory-blocks",
  "icon": "grid-view",
  "description": "A server-rendered directory of posts that visitors can filter by taxonomy term without a page reload.",
  "keywords": [
    "directory",
    "filter",
    "grid",
    "listing"
  ],
  "textdomain": "directory-blocks",
  "attributes": {
    "postType": {
      "type": "string",
      "default": "post"
    },
    "taxonomy": {
      "type": "string",
      "default": "category"
    },
    "perPage": {
      "type": "number",
      "default": 12
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "orderBy": {
      "type": "string",
      "default": "title"
    },
    "showFilters": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showImage": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "interactivity": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "styles": [
    {
      "name": "cards",
      "label": "Cards",
      "isDefault": true
    },
    {
      "name": "rows",
      "label": "Rows"
    }
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}